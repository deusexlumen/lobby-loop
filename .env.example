# LOBBY-LOOP GM-Proxy — Konfiguration (Kopie als .env anlegen)

# Gemini-API-Keys: einzeln oder komma-separiert mehrere
GEMINI_API_KEY=
# Free Tier fuehrt nur Flash und Flash-Lite; die 2.5er-Generation laeuft aus
# (gemini-2.5-flash zum 16.10.2026). IDs bei Umbenennung hier ueberschreiben.
GEMINI_MODEL_PRIMARY=gemini-3-flash
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite

# Proxy-Port (Default 8787)
GM_PROXY_PORT=8787
