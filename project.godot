config_version=5

[application]

config/name="LOBBY-LOOP"
config/description="Politisches Point-and-Click-RPG mit KI-Game-Master (Lobbyismus, Untersuchungsausschuss, Kommunalpolitik)."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

SaveManager="*res://scripts/autoload/SaveManager.gd"
GameState="*res://scripts/autoload/GameState.gd"
ApiClient="*res://scripts/autoload/ApiClient.gd"
FallbackDb="*res://scripts/autoload/FallbackDb.gd"
DiceRoller="*res://scripts/autoload/DiceRoller.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

environment/defaults/default_clear_color=Color(0.0784314, 0.0901961, 0.113725, 1)
